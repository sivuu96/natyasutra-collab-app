# Copy to backend/.env for local development. Placeholders only; never commit real values.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local development with Docker Compose (see deploy/docker-compose.yml):
DATABASE_URL=postgresql+psycopg://collab:change-me-locally@localhost:5432/collab

# Comma-separated list of frontend origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173

SESSION_IDLE_MINUTES=1440
SESSION_ABSOLUTE_HOURS=336

# Set to false once the initial team members have accounts (no invite flow yet).
ALLOW_REGISTRATION=true
